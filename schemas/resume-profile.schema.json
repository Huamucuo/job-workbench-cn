{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:job-workbench:resume-profile:v2",
  "title": "统一求职档案 v2（仅本机，禁止提交真实数据到仓库）",
  "description": "统一档案v2的Beta扩展：可选学位、语言、自述、加密附件和描述版本。旧v2缺少新字段时仍可读取，不推测事实。运行时验证真实日历、稳定ID、来源关联、版本引用、附件大小与内容、整体大小和联系方式；SHA256在下载附件前复核。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "profileId",
    "updatedAt",
    "isFictional",
    "contact",
    "education",
    "internships",
    "work",
    "projects",
    "skills",
    "certificates"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "profileId": {
      "type": "string",
      "pattern": "^[\\w-]{1,80}$"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "isFictional": {
      "type": "boolean"
    },
    "contact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "givenName",
        "familyName",
        "email",
        "phone",
        "city",
        "website"
      ],
      "properties": {
        "name": {
          "type": "string",
          "maxLength": 120
        },
        "givenName": {
          "type": "string",
          "maxLength": 120
        },
        "familyName": {
          "type": "string",
          "maxLength": 120
        },
        "email": {
          "type": "string",
          "maxLength": 120
        },
        "phone": {
          "type": "string",
          "maxLength": 120
        },
        "city": {
          "type": "string",
          "maxLength": 120
        },
        "website": {
          "type": "string",
          "maxLength": 500
        },
        "gender": {
          "type": "string",
          "maxLength": 120,
          "description": "可选，旧 v2 缺失时迁移为空；不从其他资料推测"
        },
        "politicalStatus": {
          "type": "string",
          "maxLength": 120,
          "description": "可选，旧 v2 缺失时迁移为空；不从其他资料推测"
        },
        "province": {
          "type": "string",
          "maxLength": 120,
          "description": "可选，旧 v2 缺失时迁移为空；不从其他资料推测"
        },
        "district": {
          "type": "string",
          "maxLength": 120,
          "description": "可选，旧 v2 缺失时迁移为空；不从其他资料推测"
        },
        "birthDate": {
          "type": "string",
          "pattern": "^(|[0-9]{4}(-[0-9]{2}(-[0-9]{2})?)?)$",
          "description": "只保存明确提供的信息，保持年份/年月/完整日期精度"
        }
      }
    },
    "education": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "$ref": "#/$defs/education"
      }
    },
    "internships": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "$ref": "#/$defs/internships"
      }
    },
    "work": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "$ref": "#/$defs/work"
      }
    },
    "projects": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "$ref": "#/$defs/projects"
      }
    },
    "skills": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "$ref": "#/$defs/skills"
      }
    },
    "certificates": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "$ref": "#/$defs/certificates"
      }
    },
    "importData": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "sources",
        "fields",
        "unresolved"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "sources": {
          "type": "array",
          "maxItems": 10,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "name",
              "type",
              "text",
              "warnings",
              "importedAt"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "name": {
                "type": "string",
                "maxLength": 240
              },
              "type": {
                "enum": [
                  "docx",
                  "pdf"
                ]
              },
              "text": {
                "type": "string",
                "maxLength": 60000
              },
              "warnings": {
                "type": "array",
                "maxItems": 100,
                "items": {
                  "type": "string",
                  "maxLength": 500
                }
              },
              "importedAt": {
                "type": "string",
                "format": "date-time"
              }
            }
          }
        },
        "fields": {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "sourceId",
              "line",
              "page",
              "quote",
              "confidence",
              "reason",
              "reviewed",
              "edited"
            ],
            "properties": {
              "path": {
                "type": "string",
                "pattern": "^(contact\\.[a-zA-Z]+|about\\.(introduction|other)|(?:education|internships|work|projects|skills|certificates|languages)\\.[\\w-]{1,80}\\.[a-zA-Z]+)$"
              },
              "sourceId": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "line": {
                "type": "integer",
                "minimum": 1,
                "maximum": 60000
              },
              "page": {
                "type": "integer",
                "minimum": 1,
                "maximum": 60000
              },
              "quote": {
                "type": "string",
                "maxLength": 300
              },
              "confidence": {
                "enum": [
                  "high",
                  "medium",
                  "low"
                ]
              },
              "reason": {
                "type": "string",
                "maxLength": 200
              },
              "reviewed": {
                "type": "boolean"
              },
              "edited": {
                "type": "boolean"
              }
            }
          }
        },
        "unresolved": {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "sourceId",
              "line",
              "page",
              "text",
              "reason"
            ],
            "properties": {
              "sourceId": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "line": {
                "type": "integer",
                "minimum": 1,
                "maximum": 60000
              },
              "page": {
                "type": "integer",
                "minimum": 1,
                "maximum": 60000
              },
              "text": {
                "type": "string",
                "maxLength": 3000
              },
              "reason": {
                "type": "string",
                "maxLength": 200
              }
            }
          }
        }
      }
    },
    "languages": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "$ref": "#/$defs/languages"
      },
      "description": "可选，多条语言记录；未明确提供的等级、考试和成绩留空"
    },
    "about": {
      "$ref": "#/$defs/about"
    },
    "attachments": {
      "type": "array",
      "maxItems": 2,
      "items": {
        "$ref": "#/$defs/attachment"
      },
      "description": "可选，最多2份，每份原始内容512KiB，总内容1MiB；运行时还验证base64规范与size一致；只随档案加密，不自动上传"
    },
    "variants": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "$ref": "#/$defs/variant"
      }
    },
    "activeVariantId": {
      "type": "string",
      "pattern": "^(|[\\w-]{1,80})$",
      "description": "可选，空字符串使用基础表述；非空必须引用既有variant.id"
    }
  },
  "$defs": {
    "education": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "school",
        "degree",
        "major",
        "startDate",
        "endDate"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[\\w-]{1,80}$"
        },
        "school": {
          "type": "string",
          "maxLength": 200
        },
        "degree": {
          "type": "string",
          "maxLength": 200
        },
        "major": {
          "type": "string",
          "maxLength": 200
        },
        "startDate": {
          "type": "string",
          "maxLength": 200,
          "pattern": "^(|[0-9]{4}(-[0-9]{2}(-[0-9]{2})?)?)$"
        },
        "endDate": {
          "type": "string",
          "maxLength": 200,
          "pattern": "^(|[0-9]{4}(-[0-9]{2}(-[0-9]{2})?)?)$"
        },
        "academicDegree": {
          "type": "string",
          "maxLength": 200,
          "description": "可选，独立于学历degree；仅保存明确提供的学位，不从学历或专业推断"
        }
      }
    },
    "internships": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "organization",
        "title",
        "startDate",
        "endDate",
        "description"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[\\w-]{1,80}$"
        },
        "organization": {
          "type": "string",
          "maxLength": 200
        },
        "title": {
          "type": "string",
          "maxLength": 200
        },
        "startDate": {
          "type": "string",
          "maxLength": 200,
          "pattern": "^(|[0-9]{4}(-[0-9]{2}(-[0-9]{2})?)?)$"
        },
        "endDate": {
          "type": "string",
          "maxLength": 200,
          "pattern": "^(|[0-9]{4}(-[0-9]{2}(-[0-9]{2})?)?)$"
        },
        "description": {
          "type": "string",
          "maxLength": 6000
        }
      }
    },
    "work": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "organization",
        "title",
        "startDate",
        "endDate",
        "description"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[\\w-]{1,80}$"
        },
        "organization": {
          "type": "string",
          "maxLength": 200
        },
        "title": {
          "type": "string",
          "maxLength": 200
        },
        "startDate": {
          "type": "string",
          "maxLength": 200,
          "pattern": "^(|[0-9]{4}(-[0-9]{2}(-[0-9]{2})?)?)$"
        },
        "endDate": {
          "type": "string",
          "maxLength": 200,
          "pattern": "^(|[0-9]{4}(-[0-9]{2}(-[0-9]{2})?)?)$"
        },
        "description": {
          "type": "string",
          "maxLength": 6000
        }
      }
    },
    "projects": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "role",
        "startDate",
        "endDate",
        "description"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[\\w-]{1,80}$"
        },
        "name": {
          "type": "string",
          "maxLength": 200
        },
        "role": {
          "type": "string",
          "maxLength": 200
        },
        "startDate": {
          "type": "string",
          "maxLength": 200,
          "pattern": "^(|[0-9]{4}(-[0-9]{2}(-[0-9]{2})?)?)$"
        },
        "endDate": {
          "type": "string",
          "maxLength": 200,
          "pattern": "^(|[0-9]{4}(-[0-9]{2}(-[0-9]{2})?)?)$"
        },
        "description": {
          "type": "string",
          "maxLength": 6000
        }
      }
    },
    "skills": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "level"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[\\w-]{1,80}$"
        },
        "name": {
          "type": "string",
          "maxLength": 200
        },
        "level": {
          "type": "string",
          "maxLength": 200
        }
      }
    },
    "certificates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "issuer",
        "date"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[\\w-]{1,80}$"
        },
        "name": {
          "type": "string",
          "maxLength": 200
        },
        "issuer": {
          "type": "string",
          "maxLength": 200
        },
        "date": {
          "type": "string",
          "maxLength": 200,
          "pattern": "^(|[0-9]{4}(-[0-9]{2}(-[0-9]{2})?)?)$"
        }
      }
    },
    "languages": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "level",
        "certificate"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[\\w-]{1,80}$"
        },
        "name": {
          "type": "string",
          "maxLength": 200
        },
        "level": {
          "type": "string",
          "maxLength": 200
        },
        "certificate": {
          "type": "string",
          "maxLength": 200
        }
      }
    },
    "about": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "introduction": {
          "type": "string",
          "maxLength": 6000
        },
        "other": {
          "type": "string",
          "maxLength": 6000
        }
      }
    },
    "attachment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "type",
        "size",
        "sha256",
        "dataBase64"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[\\w-]{1,80}$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240,
          "pattern": "^[^\\\\/:*?\"<>|\\u0000-\\u001f\\u007f]+$"
        },
        "type": {
          "type": "string",
          "maxLength": 120,
          "pattern": "^[\\w.+-]+/[\\w.+-]+$"
        },
        "size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 524288
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "dataBase64": {
          "type": "string",
          "maxLength": 699052,
          "pattern": "^[A-Za-z0-9+/]*={0,2}$"
        }
      }
    },
    "descriptionOverride": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "section",
        "recordId",
        "description"
      ],
      "properties": {
        "section": {
          "enum": [
            "internships",
            "work",
            "projects"
          ]
        },
        "recordId": {
          "type": "string",
          "pattern": "^[\\w-]{1,80}$"
        },
        "description": {
          "type": "string",
          "maxLength": 6000
        }
      }
    },
    "variant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "descriptions"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[\\w-]{1,80}$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "descriptions": {
          "type": "array",
          "maxItems": 90,
          "items": {
            "$ref": "#/$defs/descriptionOverride"
          }
        },
        "about": {
          "$ref": "#/$defs/about"
        }
      },
      "description": "只覆盖既有经历的description以及自述。运行时验证recordId存在和引用唯一性；身份、记录名称、职位和日期不能放入版本"
    }
  }
}

