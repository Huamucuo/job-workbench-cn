{
  "manifest_version": 3,
  "name": "职有引力 · 本机求职填表",
  "version": "0.4.0",
  "description": "本机加密档案，先核对再填写；不提交申请。",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "核对并填写当前页"
  },
  "options_page": "profile.html",
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src 'self'; base-uri 'none'; form-action 'none'"
  },
  "version_name": "0.4.0 Beta RC1",
  "background": {
    "service_worker": "background.mjs",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "http://127.0.0.1/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ]
}
